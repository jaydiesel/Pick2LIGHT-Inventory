{
  "name": "pick2light-web",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "gen:api": "cd ../server && uv run pick2light openapi > ../web/openapi.json && cd ../web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@primevue/themes": "4.5.4",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "2.2.12"
  }
}
