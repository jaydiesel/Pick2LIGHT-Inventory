{
  "name": "pick2light-web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest",
    "gen:api": "cd ../server && uv run pick2light openapi > ../web/openapi.json && cd ../web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
