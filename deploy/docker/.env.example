# Pick2LIGHT-Inventory — copy this file to .env and edit.

# Password for the PostgreSQL database (required). Pick something long and random.
P2L_DB_PASSWORD=change-me

# Port the web app listens on (http://<this-machine>:<port>, or http://pick2light.local later).
P2L_HTTP_PORT=80

# Port PostgreSQL listens on, on 127.0.0.1 only. Change it if this machine already runs PostgreSQL.
P2L_DB_PORT=5432

# Where uploaded files (photos, datasheets) are stored on this machine.
P2L_DATA_DIR=./data

# Where nightly backups are written. Point it at a USB stick or network share if you like.
P2L_BACKUP_DIR=./backups

# Time zone for the nightly backup schedule, e.g. America/Chicago or Europe/Berlin.
TZ=Etc/UTC

# Image version to run (latest, or a release tag such as v0.1.0).
P2L_VERSION=latest
